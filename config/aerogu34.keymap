#define ZMK_POINTING_DEFAULT_SCRL_VAL 200

#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// OS設定を日本語キーボードのまま使用するための変換定義

#define JP_DQUOTE       AT                // "
#define JP_AMPERSAND    CARET             // &e
#define JP_QUOTE        AMPERSAND         // '
#define JP_EQUAL        UNDER             // =
#define JP_CARET        EQUAL             // ^
#define JP_YEN          0x89              // ¥
#define JP_PLUS         COLON             // +
#define JP_TILDE        PLUS              // ~
#define JP_PIPE         LS(0x89)          // |
#define JP_AT           LEFT_BRACKET      // @
#define JP_COLON        SINGLE_QUOTE      // :
#define JP_ASTERISK     DOUBLE_QUOTES     // *
#define JP_BACKQUOTE    LEFT_BRACE        // `
#define JP_UNDERSCORE   LS(0x87)          // _
#define JP_LBRACKET     RIGHT_BRACKET     // [
#define JP_RBRACKET     BACKSLASH         // ]
#define JP_LPAREN       ASTERISK          // (
#define JP_RPAREN       LEFT_PARENTHESIS  // )
#define JP_LBRACE       RIGHT_BRACE       // {
#define JP_RBRACE       PIPE              // }
#define JP_KANA         LANGUAGE_1        // かな
#define JP_EISU         LANGUAGE_2        // 英数
#define JP_HANZEN       GRAVE             // 半角/全角

&mt {
    tapping-term-ms = <300>;
    flavor = "balanced";
};

&lt { quick-tap-ms = <300>; };

/ {
    combos {
        compatible = "zmk,combos";

        n {
            bindings = <&kp N>;
            key-positions = <16 17>;
            layers = <0>;
        };

        m {
            bindings = <&kp M>;
            key-positions = <17 18>;
            layers = <0>;
        };

        x {
            bindings = <&kp X>;
            key-positions = <16 18>;
            layers = <0>;
        };

        y {
            bindings = <&lt 5 Y>;
            key-positions = <27 28>;
            layers = <0>;
            timeout-ms = <80>;
        };

        p {
            bindings = <&kp P>;
            key-positions = <27 26>;
            layers = <0>;
        };

        f {
            bindings = <&kp F>;
            key-positions = <12 13>;
            layers = <0>;
        };

        r {
            bindings = <&kp R>;
            key-positions = <11 12>;
            layers = <0>;
        };

        q {
            bindings = <&kp Q>;
            key-positions = <11 13>;
            layers = <0>;
        };

        v {
            bindings = <&kp V>;
            key-positions = <22 23>;
            layers = <0>;
        };

        c {
            bindings = <&kp C>;
            key-positions = <21 22>;
            layers = <0>;
        };

        backslash {
            bindings = <&kp BACKSLASH>;
            key-positions = <11 12>;
            layers = <1>;
        };

        leftbracket {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <12 13>;
            layers = <1>;
        };

        rightbraket {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <16 17>;
            layers = <1>;
        };

        slash {
            bindings = <&kp SLASH>;
            key-positions = <17 18>;
            layers = <1>;
        };

        medialayer {
            bindings = <&mo 4>;
            key-positions = <20 29>;
            layers = <0>;
        };

        colon {
            bindings = <&kp SEMICOLON>;
            key-positions = <26 27>;
            layers = <1>;
        };

        quote {
            bindings = <&kp SQT>;
            key-positions = <28 27>;
            layers = <1>;
        };

        z {
            bindings = <&kp Z>;
            key-positions = <21 23>;
            layers = <0>;
        };

        b {
            bindings = <&kp B>;
            key-positions = <26 28>;
            layers = <0>;
        };

        tilde {
            bindings = <&kp GRAVE>;
            key-positions = <23 22>;
            layers = <1>;
        };

        f11 {
            bindings = <&kp F11>;
            key-positions = <21 22>;
            layers = <2>;
        };

        f12 {
            bindings = <&kp F12>;
            key-positions = <22 23>;
            layers = <2>;
        };

        comma {
            bindings = <&kp COMMA>;
            key-positions = <32 27>;
            layers = <0>;
        };

        period {
            bindings = <&kp PERIOD>;
            key-positions = <32 28>;
            layers = <0>;
        };

        minus {
            bindings = <&kp MINUS>;
            key-positions = <12 11>;
            layers = <2>;
        };

        equal {
            bindings = <&kp EQUAL>;
            key-positions = <17 18>;
            layers = <2>;
        };

        caps {
            bindings = <&caps_word>;
            key-positions = <11 18>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default {
            bindings = <
&none            &none        &none               &none           &none  &none        &none            &none                &none              &none
&none            &mt LSHFT W  &mt LEFT_CONTROL E  &mt LEFT_ALT T  &none  &none        &mt RIGHT_ALT U  &mt RIGHT_CONTROL I  &mt RIGHT_SHIFT O  &none
&mt LEFT_GUI A   &kp S        &kp D               &kp G           &none  &none        &kp H            &kp J                &kp K              &mt RIGHT_GUI L
&lt 3 BACKSPACE  &lt 2 SPACE                                             &lt 1 ENTER  &lt 1 ESCAPE
            >;
        };

        number {
            bindings = <
&trans           &trans                   &trans                     &trans                 &trans  &trans  &trans                  &trans                &trans                    &trans
&trans           &mt LEFT_SHIFT NUMBER_1  &mt LEFT_CONTROL NUMBER_2  &mt LEFT_ALT NUMBER_3  &trans  &trans  &mt RIGHT_ALT NUMBER_4  &mt RIGHT_CONTROL N5  &mt RIGHT_SHIFT NUMBER_6  &trans
&mt LEFT_GUI N7  &kp N8                   &kp N9                     &kp N0                 &trans  &trans  &kp LEFT_ARROW          &kp DOWN_ARROW        &kp UP_ARROW              &mt RIGHT_GUI RIGHT_ARROW
&kp DEL          &lt 2 TAB                                                                          &trans  &studio_unlock
            >;
        };

        function {
            bindings = <
&trans           &trans             &trans               &trans           &trans  &trans        &trans            &trans                &trans              &trans
&trans           &mt LEFT_SHIFT F1  &mt LEFT_CONTROL F2  &mt LEFT_ALT F3  &trans  &trans        &mt RIGHT_ALT F4  &mt RIGHT_CONTROL F5  &mt RIGHT_SHIFT F6  &trans
&mt LEFT_GUI F7  &kp F8             &kp F9               &kp F10          &trans  &trans        &kp PAGE_UP       &kp PAGE_DOWN         &kp HOME            &mt RIGHT_GUI END
&kp CLCK         &trans                                                           &lt 1 ESCAPE  &kp INS
            >;
        };

        mouse {
            bindings = <
&trans        &trans          &trans            &trans        &trans  &trans          &trans        &trans     &trans     &trans
&trans        &kp LEFT_SHIFT  &kp LEFT_CONTROL  &kp LEFT_ALT  &trans  &trans          &mkp LCLK     &mkp MCLK  &mkp RCLK  &trans
&kp LEFT_GUI  &none           &none             &none         &trans  &trans          &mkp MB4      &mkp MB5   &none      &none
&trans        &none                                                   &msc SCRL_DOWN  &msc SCRL_UP
            >;
        };

        media {
            bindings = <
&trans  &trans          &trans            &trans      &trans  &trans  &trans             &trans      &trans           &trans
&trans  &kp K_PREVIOUS  &kp K_PLAY_PAUSE  &kp K_NEXT  &trans  &trans  &none              &none       &none            &trans
&none   &kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp C_NEXT  &trans  &trans  &kp K_VOLUME_DOWN  &kp K_MUTE  &kp K_VOLUME_UP  &none
&none   &mo 5                                                 &none   &none
            >;
        };

        ble {
            bindings = <
&trans      &trans        &trans        &trans        &trans  &trans  &trans          &trans        &trans  &trans
&trans      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans  &trans  &bt BT_SEL 3    &bt BT_SEL 4  &none   &trans
&none       &none         &none         &none         &trans  &trans  &none           &none         &none   &none
&bt BT_CLR  &none                                             &trans  &studio_unlock
            >;
        };
    };
};
